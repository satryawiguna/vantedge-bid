# ---- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---- postgres ----------------------------------------------------------------
DATABASE_URL=postgres://vantedge:vantedge@localhost:5432/vantedge
DATABASE_POOL_SIZE=10

# ---- redis / queue -----------------------------------------------------------
REDIS_URL=redis://localhost:6379
INGESTION_QUEUE_NAME=document-ingestion
INGESTION_CONCURRENCY=5
INGESTION_MAX_ATTEMPTS=5

# ---- object storage (MinIO locally, S3/Supabase Storage in production) -------
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=tender-documents
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Local-disk driver (STORAGE_DRIVER=local) — used by tests and offline demos
STORAGE_LOCAL_ROOT=./.storage

# ---- upload limits -----------------------------------------------------------
# Hard ceiling enforced before the body is read. Per-document-type limits are
# stored in the document_types table and applied on top of this.
UPLOAD_MAX_BYTES=52428800
