# Copy to `.env` (git-ignored) and adjust. `docker compose` and `npm run seed`
# read it automatically. Values here are LOCAL-DEVELOPMENT defaults, not secrets.

# ---- Docker Compose host ports -----------------------------------------------
# The ports Compose publishes on YOUR machine for Postgres and Redis. Defaults
# are the standard ports. If something on your machine already uses them (a
# local Postgres or Redis, another container), pick free ones, e.g. 5433 / 6380,
# and keep DATABASE_URL and REDIS_URL below on the same ports.
# Containers talk to each other on Compose's internal network and ignore these.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# ---- demo mode (evaluation aid; OFF by default) ------------------------------
# Enables GET /v1/demo/organizations, a read-only directory of organisations
# (id, slug, name, createdAt) so you can find an X-Organization-Id to try the API.
# It is not authentication. It needs DEMO_MODE=true AND a non-production NODE_ENV
# (development, test or demo); the application refuses to start with
# NODE_ENV=production and DEMO_MODE=true. Any other DEMO_MODE value is an error.
DEMO_MODE=false
# Docker Compose only: NODE_ENV for the api container (default `production`,
# which keeps demo mode unavailable). To use demo mode in Docker set
# DEMO_MODE=true and API_NODE_ENV=demo.
# API_NODE_ENV=production

# ---- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---- postgres ----------------------------------------------------------------
# Used by anything run on your machine (npm run seed, migrate, start:dev). The
# port must match POSTGRES_HOST_PORT above.
DATABASE_URL=postgres://vantedge:vantedge@localhost:5432/vantedge
DATABASE_POOL_SIZE=10

# ---- redis / queue -----------------------------------------------------------
# The port must match REDIS_HOST_PORT above.
REDIS_URL=redis://localhost:6379
INGESTION_QUEUE_NAME=document-ingestion
INGESTION_CONCURRENCY=5
INGESTION_MAX_ATTEMPTS=5

# Republishes jobs that were committed but never reached the broker.
# Set the interval to 0 to disable (the test suite does).
INGESTION_RECONCILE_INTERVAL_MS=30000
INGESTION_RECONCILE_GRACE_MS=30000

# Window in which repeated ingestions collapse onto one tender audit.
AUDIT_DEBOUNCE_MS=3000
AUDIT_MAX_ATTEMPTS=3

# How long a claimed-but-unanswered Idempotency-Key is respected before the
# same request may take it over. Must exceed the longest a real request can take.
IDEMPOTENCY_CLAIM_LEASE_MS=120000

# ---- object storage ----------------------------------------------------------
# `local` (default) writes under STORAGE_LOCAL_ROOT and needs nothing else; it is
# single-host. Docker Compose always uses `local` (it sets its own value and
# ignores this file for storage).
# `s3` targets any S3-compatible service (AWS S3, Supabase Storage, ...). Only
# then are the STORAGE_ENDPOINT/REGION/BUCKET/KEY settings below used; they are
# placeholders. (MinIO's public Docker image is no longer published.)
STORAGE_DRIVER=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=tender-documents
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Where the `local` driver stores files (relative to where the app is started).
STORAGE_LOCAL_ROOT=./.storage

# ---- upload limits -----------------------------------------------------------
# Hard ceiling enforced before the body is read. Per-document-type limits are
# stored in the document_types table and applied on top of this.
UPLOAD_MAX_BYTES=52428800
